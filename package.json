{
  "name": "markdown-converter",
  "version": "1.0.0",
  "description": "A powerful markdown converter with rich text editor, dark mode support, and seamless import/export features. Convert your formatted text to Markdown instantly.",
  "license": "MIT",
  "keywords": [
    "markdown",
    "converter",
    "editor",
    "tiptap",
    "angular",
    "rich-text",
    "markdown-editor",
    "wysiwyg",
    "dark-mode",
    "export",
    "import"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/cdk": "^19.2.6",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/forms": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/router": "^19.2.15",
    "@tailwindcss/postcss": "^4.2.2",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-code": "^2.11.7",
    "@tiptap/extension-code-block-lowlight": "^2.11.7",
    "@tiptap/extension-floating-menu": "^2.11.5",
    "@tiptap/extension-heading": "^2.11.5",
    "@tiptap/extension-link": "^2.11.7",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.7",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-angular": "^0.486.0",
    "marked": "^16.1.1",
    "ngx-tiptap": "^12.0.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "turndown": "^7.2.0",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "1.21.2",
    "@angular/build": "^19.2.15",
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular-eslint/eslint-plugin": "^19.3.0",
    "@angular-eslint/template-parser": "^19.3.0",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.15",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.58.2",
    "@types/hast": "^3.0.4",
    "@types/marked": "^5.0.2",
    "@types/node": "^18.18.0",
    "@types/turndown": "^5.0.5",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "angular-eslint": "^19.3.0",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.12",
    "dequal": "^2.0.3",
    "devlop": "^1.1.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.4.0",
    "lowlight": "^3.3.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.2.4",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "*.js": "eslint --cache --fix"
  }
}
